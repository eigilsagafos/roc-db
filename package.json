{
    "name": "roc-db-monorepo",
    "type": "module",
    "private": true,
    "version": "0.2.0-pre.98",
    "author": {
        "name": "Eigil Sagafos"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eigilsagafos/roc-db.git"
    },
    "scripts": {
        "build": "bun --filter '*' build",
        "build:types": "bun --filter '*' build:types",
        "test": "bun --filter '*' test",
        "test:ci": "bun --filter '*' test -- --reporter=junit --reporter-outfile=junit.xml",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "bash scripts/ci-publish.sh",
        "verify-publish": "bun run scripts/verify-publish.ts"
    },
    "workspaces": [
        "packages/*",
        "packages/@roc-db/*"
    ],
    "devDependencies": {
        "@changesets/changelog-github": "^0.6.0",
        "@changesets/cli": "^2.30.0",
        "@eslint/js": "9.22.0",
        "@types/bun": "1.2.19",
        "bun": "1.2.19",
        "eslint": "9.22.0",
        "eslint-config-prettier": "10.1.1",
        "prettier": "3.5.3",
        "typescript": "5.8.2",
        "typescript-eslint": "8.26.1"
    }
}